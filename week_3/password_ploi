def check_length(password, minimum=8):
    return len(password) >= minimum


def check_uppercase(password):
    for letter in password:
        if letter.isupper():
            return True
    return False


def check_lowercase(password):
    for letter in password:
        if letter.islower():
            return True
    return False


def check_digit(password):
    for letter in password:
        if letter.isdigit():
            return True
    return False


def check_special(password):
    for letter in password:
        if not letter.isalnum():
            return True
    return False


def analyze_password(password, minimum=8):
    report = {
        "Minimum length": check_length(password, minimum),
        "Uppercase letter": check_uppercase(password),
        "Lowercase letter": check_lowercase(password),
        "Digit": check_digit(password),
        "Special character": check_special(password)
    }

    return report


passwords = [
    "hello",
    "Hello123!",
    "PASSWORD1!",
    "welcome123",
    "Abc@1234"
]

for password in passwords:
    print("\nTesting password:", password)

    result = analyze_password(password)

    for requirement in result:
        if result[requirement]:
            print(requirement, ": Pass")
        else:
            print(requirement, ": Fail")

    if all(result.values()):
        print("Password meets all requirements.")
    else:
        print("Some requirements are missing.")